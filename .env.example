# Copy to .env and fill in. Only TELEGRAM_BOT_TOKEN is required.

# Telegram bot token from @BotFather (free)
TELEGRAM_BOT_TOKEN=

# Storage (defaults match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# Transcription: local (faster-whisper, free, offline) | fake (tests) | openai_compatible
TRANSCRIBER=local
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
# Optional: override the default task-flavoured prompt that helps with homophones
# WHISPER_INITIAL_PROMPT=

# Only when TRANSCRIBER=openai_compatible (e.g. Groq free tier)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Limits / misc
MAX_VOICE_BYTES=20971520
MAX_VOICE_SECONDS=300
TRANSCRIBE_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
